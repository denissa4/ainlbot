{
    "name": "nlbotjs",
    "version": "1.0.0",
    "description": "Bot Builder v4 echo bot sample",
    "author": "Microsoft",
    "license": "MIT",
    "main": "./lib/index.js",
    "scripts": {
        "build": "tsc --build",
        "lint": "tslint -c tslint.json 'src/**/*.ts'",
        "postinstall": "npm run build && node ./deploymentScripts/webConfigPrep.js",
        "start": "tsc --build && node ./lib/index.js",
        "test": "echo \"Error: no test specified\" && exit 1",
        "watch": "nodemon --watch ./src -e ts --exec \"npm run start\""
    },
    "repository": {
        "type": "git",
        "url": "https://github.com"
    },
    "dependencies": {
        "botbuilder": "^4.23.0",
        "dotenv": "^8.2.0",
        "replace": "^1.2.0",
        "restify": "11.1.0",
        "axios": "^1.20.0"
    },
    "devDependencies": {
        "@types/dotenv": "6.1.1",
        "@types/node": "^20.11.0",
        "@types/restify": "8.4.2",
        "nodemon": "~2.0.4",
        "tslint": "~6.1.2",
        "typescript": "^5.4.5"
    },
    "overrides": {
        "tar": "^7.5.21",
        "minimatch": "^10.2.3",
        "brace-expansion": "^2.1.2",
        "cross-spawn": "^7.0.5",
        "semver": "^7.5.2",
        "ip-address": "^10.3.1",
        "glob": "^10.5.0",
        "find-my-way": "^9.7.0"
    }
